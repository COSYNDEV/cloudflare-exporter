{
  "uid": "cloudflare-exporter",
  "title": "Cloudflare Exporter",
  "description": "Health of cloudflare-exporter collection.",
  "tags": [
    "cloudflare"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "title": "Cloudflare",
      "tags": [
        "cloudflare"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Last success age",
      "description": "Time since each source last collected successfully.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (source) (time() - cloudflare_exporter_last_success_timestamp_seconds)",
          "format": "time_series",
          "instant": true,
          "interval": "1m",
          "legendFormat": "{{source}}",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Data lag by source",
      "description": "How far the collected data trails real time. Sits near COLLECT_DELAY and grows while collection fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (source) (time() - cloudflare_exporter_watermark_timestamp_seconds)",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Collection errors/s by source",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (source) (rate(cloudflare_exporter_errors_total[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Truncated windows by source",
      "description": "One-minute windows that hit the 10000-row query limit and are undercounted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (source) (increase(cloudflare_exporter_truncated_windows_total[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Skipped seconds by source",
      "description": "Data dropped after an outage longer than the one-hour backfill.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (source) (increase(cloudflare_exporter_skipped_seconds_total[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Build info",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "cloudflare_exporter_build_info",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true
            },
            "indexByName": {
              "version": 0,
              "revision": 1,
              "goversion": 2,
              "instance": 3
            },
            "renameByName": {
              "version": "Version",
              "revision": "Revision",
              "goversion": "Go",
              "instance": "Instance"
            }
          }
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 4
      }
    }
  ]
}
