      "title": "Top failing hosts",
      "description": "5xx responses over the selected range. 520 to 527 are Cloudflare failing to reach the origin: 521 origin down, 522 connection timed out, 525 TLS handshake failed. 500 to 504 come from the origin itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(20,\n  sum by (zone, host, status) (increase(cloudflare_zone_requests_total{zone=~\"$zone\",host=~\"$host\",status=~\"5..\"}[$__range]))\n) > 0",
          "format": "table",
