{
  "uid": "cloudflare-r2",
  "title": "Cloudflare R2",
  "description": "R2 storage and operations from cloudflare-exporter.",
  "tags": [
    "cloudflare"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "title": "Cloudflare",
      "tags": [
        "cloudflare"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({__name__=~\"cloudflare_r2_operations_total|cloudflare_r2_stored_bytes\"}, bucket)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"cloudflare_r2_operations_total|cloudflare_r2_stored_bytes\"}, bucket)",
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Stored bytes by bucket",
      "description": "Empty storage classes are hidden. The Buckets table lists every bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket, storage_class) (cloudflare_r2_stored_bytes{bucket=~\"$bucket\"}) > 0",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{bucket}} {{storage_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Objects by bucket",
      "description": "Empty storage classes are hidden. The Buckets table lists every bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket, storage_class) (cloudflare_r2_objects{bucket=~\"$bucket\"}) > 0",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{bucket}} {{storage_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Operations/s by bucket and action",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket, action) (rate(cloudflare_r2_operations_total{bucket=~\"$bucket\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{bucket}} {{action}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Failed operations/s by bucket and status",
      "description": "Operations with status code 400 or higher.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket, status_code) (rate(cloudflare_r2_operations_total{bucket=~\"$bucket\",status_code=~\"[4-9][0-9][0-9]\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "interval": "1m",
          "legendFormat": "{{bucket}} {{status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "shades",
            "fixedColor": "red"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Buckets",
      "description": "Current size of each bucket across storage classes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket) (cloudflare_r2_stored_bytes{bucket=~\"$bucket\"})",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (bucket) (cloudflare_r2_objects{bucket=~\"$bucket\"})",
          "format": "table",
          "instant": true,
          "interval": "1m",
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Stored"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Stored",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true
            },
            "indexByName": {
              "bucket": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "bucket": "Bucket",
              "Value #A": "Stored",
              "Value #B": "Objects"
            }
          }
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      }
    }
  ]
}
